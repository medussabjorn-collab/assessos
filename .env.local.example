# Copy this file to .env.local and fill in the values, then rebuild.
# These are inlined into the static build (NEXT_PUBLIC_*), so re-run `npm run build`
# after changing them.

# HTTPS REST endpoint on the AssessOS API that accepts new contact/demo
# request leads as a JSON POST (see the marketing module at
# apps/api/src/modules/marketing in the AssessOS backend). Enables the
# contact form (/contact) to actually send.
NEXT_PUBLIC_CONTACT_ENDPOINT=

# URL of the real Prelim assessment app where candidates authenticate.
# The student login page (/students) hands off here on submit.
NEXT_PUBLIC_APP_LOGIN_URL=

# HTTPS REST endpoint on the AssessOS API that accepts new student
# registrations as a JSON POST (same marketing module as above). See
# components/StudentRegistration.tsx for the exact payload shape (full name,
# email, DOB, gender, student ID, university, college, course, industry).
NEXT_PUBLIC_REGISTRATION_ENDPOINT=

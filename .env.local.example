# Copy this file to .env.local and fill in the values, then rebuild.
# These are inlined into the static build (NEXT_PUBLIC_*), so re-run `npm run build`
# after changing them.

# Formspree form id — the part after /f/ in your endpoint URL.
# Create a form at https://formspree.io, then paste its id here.
# Enables the contact form (/contact) to actually send.
NEXT_PUBLIC_FORMSPREE_ID=

# URL of the real Prelim assessment app where candidates authenticate.
# The student login page (/students) hands off here on submit.
NEXT_PUBLIC_APP_LOGIN_URL=

# HTTPS REST endpoint on your enterprise portal backend that accepts new
# student registrations as a JSON POST. Must be infrastructure you control —
# never a placeholder domain. See components/StudentRegistration.tsx for the
# exact payload shape (full name, email, DOB, gender, student ID, university,
# college, course, industry).
NEXT_PUBLIC_REGISTRATION_ENDPOINT=
